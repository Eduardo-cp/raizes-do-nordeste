# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/raizes
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/raizes_test
# true para bancos gerenciados que exigem SSL (Supabase, Render, RDS...)
DATABASE_SSL=false

# Segurança (OBRIGATÓRIO trocar em produção: use um valor longo e aleatório)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# Origens permitidas para CORS (separadas por vírgula). Vazio = apenas a mesma origem.
CORS_ORIGINS=

# Pagamentos: mock | mercadopago
PAYMENT_GATEWAY=mock
# Segredo usado para assinar/validar os webhooks do gateway simulado
WEBHOOK_SECRET=troque-este-segredo-de-webhook
# Mercado Pago (ambiente de testes/sandbox) - necessário apenas se PAYMENT_GATEWAY=mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública da API para o gateway enviar notificações (ex.: via ngrok)
PUBLIC_URL=http://localhost:3000

# Regras de negócio
# Minutos até um pedido não pago ser cancelado automaticamente (libera o estoque reservado)
PEDIDO_EXPIRACAO_MIN=30
